# Copy to .env and fill in. Never commit .env.

# Postgres (used by docker-compose.yml and the app)
POSTGRES_USER=arc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arc
DATABASE_URI=postgres://arc:change-me@127.0.0.1:5432/arc

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Address staff and the TV use to reach this computer (used in the link `pnpm display:key` prints)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
